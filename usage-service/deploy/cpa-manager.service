[Unit]
Description=CPA Manager (usage-service)
Documentation=https://github.com/fxzer/cliproxyapi-management/tree/main/usage-service
After=network-online.target cliproxyapi.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__CPA_MANAGER_SRV_PATH__
ExecStart=__CPA_MANAGER_SRV_PATH__/cpa-manager
Environment=CPA_MANAGER_CONFIG=__CPA_MANAGER_SRV_PATH__/config.json
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

# 可选：在此文件中设置 CPA_MANAGEMENT_KEY=your-plaintext-key
EnvironmentFile=-__CPA_MANAGER_SRV_PATH__/cpa-manager.env

[Install]
WantedBy=multi-user.target
