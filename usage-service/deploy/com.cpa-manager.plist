<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.local.cpa-manager</string>
	<key>ProgramArguments</key>
	<array>
		<string>__CPA_MANAGER_BIN__</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>CPA_MANAGER_CONFIG</key>
		<string>__CPA_MANAGER_CONFIG__</string>
	</dict>
	<key>WorkingDirectory</key>
	<string>__CPA_MANAGER_ROOT__</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__CPA_MANAGER_ROOT__/cpa-manager.log</string>
	<key>StandardErrorPath</key>
	<string>__CPA_MANAGER_ROOT__/cpa-manager.log</string>
</dict>
</plist>
